{
  "name": "post2md",
  "version": "0.1.0",
  "description": "CLI utility to fetch web posts by URL and convert them to GFM Markdown",
  "type": "module",
  "bin": {
    "post2md": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "@joplin/turndown-plugin-gfm": "^1.0.61",
    "@mozilla/readability": "^0.6.0",
    "commander": "^13.1.0",
    "jsdom": "^26.0.0",
    "picocolors": "^1.1.1",
    "pino": "^9.6.0",
    "turndown": "^7.2.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.13.0",
    "@types/turndown": "^5.0.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
